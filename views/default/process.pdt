<div class="container">
        <h2>{lang key="Bkash.process.heading"}</h2>
        {if isset($message)}
            <div class="alert alert-{$message_type}">
                {$message}
            </div>
        {/if}
        <p>{lang key="Bkash.process.description"}</p>
        {$form|raw}
</div>