<?php
// ──────────────────────────────────────────────────────────────────────────────
// settings.pdt — Admin settings form for the bKash gateway
//
// This template is rendered inside Blesta Admin → Settings → Payment Gateways → Manage.
// Available variables:
//   $meta (array) — Current saved settings:
//     - app_key    (string) bKash App Key
//     - app_secret (string) bKash App Secret (encrypted, always blank here)
//     - username   (string) bKash API username
//     - password   (string) bKash API password (encrypted, always blank here)
//     - sandbox    (string) "true" or "false"
// ──────────────────────────────────────────────────────────────────────────────
?>
<div class="bkash-settings-wrapper">
    <!-- bKash branding header -->
    <div class="bkash-header mb-4 p-3 rounded" style="background: linear-gradient(135deg, #e2136e 0%, #9e1638 100%);">
        <div class="d-flex align-items-center gap-3">
            <img
                src="<?php echo $this->Html->safe(WEBDIR . str_replace(ROOTWEBDIR, '', dirname(__FILE__) . DS) . 'images' . DS . 'logo.svg'); ?>"
                alt="bKash"
                style="height: 44px;"
            >
            <div class="text-white">
                <div class="fw-semibold" style="font-size: 1rem; letter-spacing: 0.02em;">Tokenized Checkout</div>
                <div style="font-size: 0.78rem; opacity: 0.85;">Secure mobile payments for Bangladesh</div>
            </div>
        </div>
    </div>

    <!-- Credentials note -->
    <div class="alert alert-info d-flex align-items-start gap-2 py-2 px-3 mb-4" style="font-size: 0.85rem;">
        <i class="bi bi-info-circle-fill mt-1 flex-shrink-0" style="color: #0d6efd;"></i>
        <span><?php $this->_('Bkash.settings.credentials_note'); ?></span>
    </div>

    <!-- API Credentials section -->
    <div class="card mb-4" style="border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden;">
        <div class="card-header py-2 px-3" style="background: #f8f9fa; border-bottom: 1px solid #dee2e6;">
            <span class="fw-semibold" style="font-size: 0.88rem; color: #495057;">
                <i class="bi bi-key me-1" style="color: #e2136e;"></i>
                <?php echo $this->Html->safe($this->_('Bkash.section.api_credentials', true) ?: 'API Credentials'); ?>
            </span>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <?php
                    $this->Form->label($this->_('Bkash.app_key', true), 'app_key', ['class' => 'form-label fw-medium']);
                    $this->Form->fieldText('app_key', ($meta['app_key'] ?? null), [
                        'id'          => 'app_key',
                        'class'       => 'form-control',
                        'placeholder' => 'Enter your bKash App Key',
                    ]);
                    ?>
                </div>
                <div class="col-12 col-md-6">
                    <?php
                    $this->Form->label($this->_('Bkash.app_secret', true), 'app_secret', ['class' => 'form-label fw-medium']);
                    $this->Form->fieldPassword('app_secret', [
                        'id'           => 'app_secret',
                        'class'        => 'form-control',
                        'autocomplete' => 'new-password',
                        'placeholder'  => '••••••••••••',
                    ]);
                    ?>
                </div>
                <div class="col-12 col-md-6">
                    <?php
                    $this->Form->label($this->_('Bkash.username', true), 'username', ['class' => 'form-label fw-medium']);
                    $this->Form->fieldText('username', ($meta['username'] ?? null), [
                        'id'          => 'username',
                        'class'       => 'form-control',
                        'placeholder' => 'Enter your API username',
                    ]);
                    ?>
                </div>
                <div class="col-12 col-md-6">
                    <?php
                    $this->Form->label($this->_('Bkash.password', true), 'password', ['class' => 'form-label fw-medium']);
                    $this->Form->fieldPassword('password', [
                        'id'           => 'password',
                        'class'        => 'form-control',
                        'autocomplete' => 'new-password',
                        'placeholder'  => '••••••••••••',
                    ]);
                    ?>
                </div>
            </div>
        </div>
    </div>

    <!-- Gateway Mode section -->
    <!--
        Uses a SINGLE checkbox, matching the Paysera/SSLCommerz pattern:
        - Checked   → sandbox = "true"  (test mode)
        - Unchecked → sandbox is NOT submitted, editSettings() defaults to "false" (live mode)
        This is how HTML checkboxes work — unchecked checkboxes are not included in form data.
    -->
    <div class="card" style="border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden;">
        <div class="card-header py-2 px-3" style="background: #f8f9fa; border-bottom: 1px solid #dee2e6;">
            <span class="fw-semibold" style="font-size: 0.88rem; color: #495057;">
                <i class="bi bi-gear me-1" style="color: #e2136e;"></i>
                <?php echo $this->Html->safe($this->_('Bkash.section.mode', true) ?: 'Gateway Mode'); ?>
            </span>
        </div>
        <div class="card-body p-3">
            <div class="form-check form-switch">
                <?php
                // Single checkbox: checked = sandbox enabled, unchecked = live mode
                $this->Form->fieldCheckbox(
                    'sandbox',
                    'true',
                    (($meta['sandbox'] ?? 'true') === 'true'),
                    ['id' => 'sandbox', 'class' => 'form-check-input']
                );
                $this->Form->label($this->_('Bkash.sandbox', true), 'sandbox', ['class' => 'form-check-label']);
                ?>
            </div>
            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                <i class="bi bi-exclamation-triangle me-1" style="color: #ffc107;"></i>
                <?php $this->_('Bkash.settings.mode_note'); ?>
            </p>
        </div>
    </div>
</div>
