{*
 * bKash Payment Gateway Settings Template
 *
 * This template displays the settings form for configuring bKash API credentials
 * in the Blesta admin interface.
 *}
{extends file="admin_main"}
{block name="content"}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">{lang key="Bkash.settings.heading"}</h3>
    </div>
    <div class="card-body">
        {if isset($message)}
            <div class="alert alert-{$message_type}">
                {$message}
            </div>
        {/if}
        <form action="{$base_uri}admin/settings/company/gateways/edit/{$gateway->id}/" method="post">
            <div class="form-group">
                <label for="username">{lang key="Bkash.settings.username"}</label>
                <input type="text" class="form-control" name="meta[username]" id="username" value="{$meta.username|default:''}" />
            </div>
            <div class="form-group">
                <label for="password">{lang key="Bkash.settings.password"}</label>
                <input type="password" class="form-control" name="meta[password]" id="password" value="{$meta.password|default:''}" />
            </div>
            <div class="form-group">
                <label for="app_key">{lang key="Bkash.settings.app_key"}</label>
                <input type="text" class="form-control" name="meta[app_key]" id="app_key" value="{$meta.app_key|default:''}" />
            </div>
            <div class="form-group">
                <label for="app_secret">{lang key="Bkash.settings.app_secret"}</label>
                <input type="password" class="form-control" name="meta[app_secret]" id="app_secret" value="{$meta.app_secret|default:''}" />
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">{lang key="Bkash.settings.submit"}</button>
            </div>
        </form>
    </div>
</div>
{/block}